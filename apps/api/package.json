{
  "name": "@tfm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@tfm/source src/main.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/scripts/assets','dist/scripts/assets',{recursive:true})\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "try-extract": "tsx --conditions=@tfm/source src/scripts/try-extract.ts",
    "seed": "node dist/scripts/seed.js",
    "seed:dev": "tsx --conditions=@tfm/source src/scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@hono/node-server": "2.1.5",
    "@tfm/contracts": "*",
    "hono": "4.13.13",
    "mongodb": "7.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
